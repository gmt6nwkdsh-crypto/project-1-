cup scoops in a buttered pan, 2 minutes per side.","Top with maple syrup."],"note":"","cal":388,"p":24.3,"c":45.8,"f":12.1,"diets":["general","vegetarian","pescatarian","gluten_free","no_pork"]},{"id":"protein-smoothie","name":"Berry banana protein smoothie","cuisine":"general","time":5,"serves":1,"tags":[],"ingredients":["1 scoop whey","1 cup 2% milk","1 banana","⅔ cup frozen berries"],"steps":["Blend everything with a few ice cubes until smooth."],"note":"","cal":379,"p":34.1,"c":48.7,"f":7.3,"diets":["general","high_protein","vegetarian","pescatarian","gluten_free","no_pork"]},{"id":"vegan-pb-smoothie","name":"Peanut butter banana smoothie (vegan)","cuisine":"general","time":5,"serves":1,"tags":[],"ingredients":["1 scoop pea protein","1 cup soy milk","1 banana","1 tbsp peanut butter","¼ cup oats"],"steps":["Blend everything with ice until smooth."],"note":"","cal":469,"p":39,"c":49,"f":15.3,"diets":["general","high_protein","vegetarian","vegan","pescatarian","gluten_free","dairy_free","no_pork"]},{"id":"breakfast-burritos","name":"Freezer breakfast burritos","cuisine":"general","time":30,"serves":4,"tags":["make ahead"],"ingredients":["6 eggs","1 cup egg whites","½ lb raw ground turkey","1 cup black beans","½ cup cheddar","4 large tortillas","¼ cup salsa"],"steps":["Brown the turkey; scramble in the eggs and egg whites.","Fill tortillas with eggs, beans, cheese and salsa, and roll tightly.","Wrap in foil and freeze. Reheat 2 minutes in the microwave (remove foil)."],"note":"","cal":471,"p":37.1,"c":34.9,"f":19.8,"diets":["general","high_protein","no_pork"]},{"id":"cauli-burrito-bowl","name":"Cauliflower rice chicken burrito bowl","cuisine":"general","time":20,"serves":2,"tags":["low carb"],"ingredients":["10 oz raw boneless chicken thighs","3 cups cauliflower rice","½ cup black beans","6 tbsp salsa","½ avocado","½ tbsp oil","cumin, chili powder, lime"],"steps":["Season and pan-cook the chicken, 6 minutes per side; slice.","Cook the cauliflower rice in the same pan for 5 minutes.","Build bowls with beans, salsa and avocado."],"note":"","cal":386,"p":34.3,"c":24,"f":18,"diets":["general","high_protein","gluten_free","dairy_free","no_pork"]},{"id":"tempeh-peanut-bowl","name":"Tempeh peanut noodle bowl","cuisine":"general","time":20,"serves":2,"tags":[],"ingredients":["8 oz tempeh, cubed","1½ cups cooked rice noodles","1 carrot, shredded","1 cup shredded cabbage","2 tbsp peanut butter","1 tbsp tamari","½ tbsp oil"],"steps":["Brown the tempeh in the oil, about 8 minutes.","Whisk peanut butter, tamari, lime and hot water into a sauce.","Toss noodles, vegetables, tempeh and sauce together."],"note":"","cal":513,"p":31.1,"c":49.5,"f":24.1,"diets":["general","vegetarian","vegan","pescatarian","gluten_free","dairy_free","no_pork"]},{"id":"baked-cod","name":"Lemon baked cod with potatoes & green beans","cuisine":"general","time":30,"serves":2,"tags":[],"ingredients":["2 cod fillets (about 12 oz raw)","2 medium potatoes","2 cups green beans","1½ tbsp olive oil","lemon, garlic, parsley"],"steps":["Roast cubed potatoes with half the oil at 425°F for 15 minutes.","Add cod and green beans, drizzle with the rest of the oil and lemon.","Bake 12 more minutes until the fish flakes."],"note":"","cal":437,"p":37.8,"c":46.6,"f":11.8,"diets":["general","high_protein","pescatarian","gluten_free","dairy_free","no_pork"]},{"id":"spinach-feta-omelet","name":"Spinach & feta omelet","cuisine":"general","time":10,"serves":1,"tags":["low carb"],"ingredients":["3 eggs","1 cup spinach","¼ cup feta","½ cup mushrooms","1 tsp butter"],"steps":["Cook mushrooms and spinach in the butter.","Pour in beaten eggs; cook until almost set.","Add feta, fold, and cook 1 more minute."],"note":"","cal":342,"p":25.3,"c":4.9,"f":24.5,"diets":["general","vegetarian","pescatarian","low_carb","gluten_free","no_pork"]},{"id":"edamame-rice-bowl","name":"Edamame brown rice bowl","cuisine":"general","time":15,"serves":1,"tags":[],"ingredients":["1 cup shelled edamame","¾ cup cooked brown rice","1 carrot","¾ cup cucumber","1 tbsp tamari","⅓ avocado"],"steps":["Warm the edamame and rice.","Top with sliced carrot, cucumber and avocado.","Drizzle with tamari (and sriracha if you like)."],"note":"","cal":493,"p":25.9,"c":65.6,"f":16.9,"diets":["general","vegetarian","vegan","pescatarian","gluten_free","dairy_free","no_pork"]},{"id":"chicken-fajitas","name":"Chicken fajitas on corn tortillas","cuisine":"general","time":25,"serves":3,"tags":[],"ingredients":["1 lb raw chicken breast, sliced","2 bell peppers","1 onion","6 corn tortillas","1 tbsp oil","6 tbsp salsa","fajita seasoning, lime"],"steps":["Sear the chicken with seasoning in half the oil; set aside.","Cook peppers and onion in the rest of the oil until charred at the edges.","Add chicken back with lime. Serve in warm tortillas with salsa."],"note":"","cal":393,"p":39.8,"c":33.6,"f":10.6,"diets":["general","high_protein","gluten_free","dairy_free","no_pork"]},{"id":"pb-banana-toast","name":"Peanut butter banana toast","cuisine":"general","time":5,"serves":1,"tags":[],"ingredients":["2 slices whole wheat bread","2 tbsp peanut butter","1 banana","½ tbsp chia (optional)"],"steps":["Toast the bread, spread with peanut butter, top with sliced banana and chia."],"note":"","cal":484,"p":18.2,"c":63.2,"f":20.4,"diets":["general","vegetarian","vegan","pescatarian","dairy_free","no_pork"]},{"id":"hummus-plate","name":"Hummus snack plate","cuisine":"general","time":5,"serves":1,"tags":[],"ingredients":["¼ cup hummus","½ pita","1 cup cucumber","1 carrot","2 tbsp feta"],"steps":["Slice the vegetables and pita; serve with hummus and feta."],"note":"","cal":259,"p":10.6,"c":35.4,"f":9.3,"diets":["general","vegetarian","pescatarian","no_pork"]},{"id":"cachupa-rica","name":"Cachupa rica","cuisine":"cv","time":180,"serves":8,"tags":["Cape Verdean","big pot"],"ingredients":["1 lb dried hominy (milho), soaked overnight","1 cup dried beans (feijão), soaked","1 lb raw pork shoulder, cubed","½ lb linguiça, sliced","¾ lb raw beef chuck","¼ head cabbage","1 sweet potato","1 wedge squash","1 small mandioca","1 onion","3 tbsp oil","garlic, bay leaf, salt"],"steps":["Simmer the soaked hominy and beans in plenty of water for about 1½ hours until tender.","Brown the meats with onion, garlic and bay leaf in the oil, then add them to the pot.","Add cabbage, sweet potato, squash and mandioca; simmer 45 more minutes.","Season to taste. One serving is about 1½ cups. Leftovers make cachupa guisada."],"note":"Every family makes it differently. Change the meats or portion size in the log after you tap Log.","cal":578,"p":32.9,"c":58.4,"f":24.3,"diets":["general","gluten_free","dairy_free"]},{"id":"cachupa-pobre","name":"Cachupa pobre (no meat)","cuisine":"cv","time":150,"serves":6,"tags":["Cape Verdean","big pot"],"ingredients":["¾ lb dried hominy, soaked","¾ cup dried beans, soaked","¼ head cabbage","1 sweet potato","1 wedge squash","1 onion","1 tomato","3 tbsp oil","garlic, bay leaf, salt"],"steps":["Simmer hominy and beans about 1½ hours until tender.","Make a refogado: cook onion, tomato, garlic and bay leaf in the oil, and stir it into the pot.","Add the vegetables and simmer 40 more minutes. Season."],"note":"","cal":336,"p":10.5,"c":55.5,"f":8.9,"diets":["general","vegetarian","vegan","pescatarian","gluten_free","dairy_free","no_pork"]},{"id":"cachupa-guisada","name":"Cachupa guisada with eggs","cuisine":"cv","time":15,"serves":1,"tags":["Cape Verdean","breakfast"],"ingredients":["1¼ cups leftover cachupa (hominy & beans)","a few slices linguiça","2 eggs","2 tsp oil"],"steps":["Fry the leftover cachupa and linguiça in the oil until crispy at the edges.","Fry two eggs alongside and serve on top."],"note":"","cal":584,"p":27.7,"c":46.1,"f":32.1,"diets":["general","gluten_free","dairy_free"]},{"id":"jagacida","name":"Jagacida (rice & beans)","cuisine":"cv","time":40,"serves":4,"tags":["Cape Verdean"],"ingredients":["1½ cups dry rice","2 cups cooked beans","1 onion","1 tomato","2 tbsp oil","garlic, bay leaf, salt"],"steps":["Cook onion, garlic, tomato and bay leaf in the oil.","Add the beans, rice and 3 cups water; bring to a boil.","Cover and simmer on low 18–20 minutes until the rice is done."],"note":"Many families add linguiça; log it separately if you do.","cal":391,"p":12.3,"c":67.6,"f":7.7,"diets":["general","vegetarian","vegan","pescatarian","gluten_free","dairy_free","no_pork"]},{"id":"canja","name":"Canja (chicken & rice soup)","cuisine":"cv","time":50,"serves":6,"tags":["Cape Verdean"],"ingredients":["1½ lb raw boneless chicken thighs","¾ cup dry rice","1 onion","2 carrots","1 tomato","1 tbsp oil","garlic, bay leaf, salt"],"steps":["Cook onion, garlic and tomato in the oil, add chicken and 8 cups water.","Simmer 30 minutes, take out the chicken and shred it.","Add rice and carrots; simmer 15–20 minutes.","Return the chicken and season."],"note":"","cal":279,"p":21.4,"c":27.1,"f":8.8,"diets":["general","high_protein","gluten_free","dairy_free","no_pork"]},{"id":"caldo-de-peixe","name":"Caldo de peixe (fish stew)","cuisine":"cv","time":45,"serves":4,"tags":["Cape Verdean"],"ingredients":["1⅓ lb raw firm white fish (or tuna steaks)","2 potatoes","1 small mandioca","1 sweet potato","1 onion","2 tomatoes","2 tbsp oil","garlic, bay leaf, parsley, salt"],"steps":["Make a refogado with oil, onion, garlic, tomato and bay leaf.","Add 6 cups water and the root vegetables; simmer 20 minutes.","Lay the fish on top, cover and simmer 10 minutes until it flakes.","Serve the fish and vegetables with the broth (often with rice or pirão)."],"note":"","cal":416,"p":32.4,"c":53.3,"f":8.4,"diets":["general","high_protein","pescatarian","gluten_free","dairy_free","no_pork"]},{"id":"pastel-de-atum","name":"Pastel de atum (tuna pastéis)","cuisine":"cv","time":60,"serves":6,"tags":["Cape Verdean","fried"],"ingredients":["1⅔ cups fine cornmeal","1 sweet potato, mashed (for the dough)","2 cans tuna","1 onion","½ tomato","oil absorbed while frying (about 4 tbsp)","garlic, malagueta pepper, parsley"],"steps":["Mix cornmeal, mashed sweet potato, salt and warm water into a soft dough.","Cook tuna with onion, tomato, garlic and malagueta for the filling.","Roll out small rounds, fill, fold into half-moons and seal.","Fry until golden. One serving is about 2 pastéis."],"note":"","cal":292,"p":13.3,"c":34.6,"f":11.6,"diets":["general","pescatarian","gluten_free","dairy_free","no_pork"]},{"id":"xerem","name":"Xerém (corn grits with linguiça)","cuisine":"cv","time":40,"serves":4,"tags":["Cape Verdean"],"ingredients":["1¼ cups coarse cornmeal / xerém","6 oz linguiça","1 onion","1 tbsp oil","garlic, bay leaf, salt"],"steps":["Brown the linguiça and onion in the oil.","Add 5 cups water and bring to a boil.","Whisk in the cornmeal slowly and cook on low, stirring, about 25 minutes until thick."],"note":"","cal":387,"p":11.5,"c":49.5,"f":16.7,"diets":["general","gluten_free","dairy_free"]},{"id":"pudim","name":"Pudim de leite (milk flan)","cuisine":"cv","time":70,"serves":8,"tags":["Cape Verdean","dessert"],"ingredients":["3 cups milk","6 eggs","vanilla, lemon peel","1½ cups sugar (caramel and custard)"],"steps":["Melt ½ cup sugar into a caramel and pour it into a flan pan.","Whisk milk, eggs, the rest of the sugar and vanilla; pour over the caramel.","Bake in a water bath at 350°F for about 50 minutes until set. Chill, then flip out."],"note":"","cal":244,"p":7.7,"c":42.2,"f":5.4,"diets":["general","vegetarian","pescatarian","gluten_free","no_pork"]}]}